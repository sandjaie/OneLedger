// Markdown lint. The hook in `.pre-commit-config.yaml` runs this on commit, so a malformed
// table or a list that will not render reaches a reader as a finding here rather than as a
// broken page.
{
  "config": {
    // 80 is markdownlint's default, not a decision anyone made here. This repository's prose
    // and its Python are both written to ~100 (`api/pyproject.toml` says so for the code), so
    // the limit follows the documents. Tables, fenced code and headings are exempt because
    // none of them can be wrapped without changing what they mean.
    "MD013": {
      "line_length": 100,
      "tables": false,
      "code_blocks": false,
      "headings": false
    },

    // Table pipe spacing. The tree uses both styles and neither is wrong; enforcing one would
    // rewrite every table in the repository to settle a question nobody has asked.
    "MD060": false,

    // A label directly above its list — `**Files.**` then the files — is this repository's
    // house style, in every plan and every task block. It renders correctly; requiring a blank
    // line between them would insert a hundred of them to no reader's benefit.
    "MD032": false,

    // Three files legitimately open with something other than a heading: the pull-request
    // template, whose body is pasted into every PR; `web/CLAUDE.md`, whose first line must be
    // the `@AGENTS.md` import; and the mockup sync note, which opens with its own key/value
    // header. A rule that three real files must break is a rule that teaches people to ignore
    // the checker.
    "MD041": false,

    // Repeated headings are fine under different parents: every task block has its own
    // `Contracts` and `Validation`. Repeating one under the *same* parent is still a mistake.
    "MD024": { "siblings_only": true }
  },

  // What a bare `markdownlint-cli2` run covers. The hook passes its own file list, so this
  // governs a manual run only — but a manual run that walked `node_modules` would be useless.
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "web/.next/**",
    "api/.venv/**",
    ".git/**",

    // Private Superpowers working notes. Git does not track them (`git ls-files .superpowers`
    // is empty), so nobody reads them as documents and nobody can fix them in a commit. The
    // comment above is optimistic: cli2 unions its own globs with the file list a caller
    // passes, so staging any `.md` at all made the hook lint these 52 files and fail — which
    // is what blocked the commit that added this line.
    ".superpowers/**"
  ]
}
