# Used only with docker-compose.production.yml through scripts/production-stack.sh.
PRODUCTION_ENV_FILE=.env.production.example
POSTGRES_USER=oneledger
POSTGRES_PASSWORD=replace-with-a-generated-secret
POSTGRES_DB=oneledger
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

AUTH_MODE=local
SESSION_SECRET=replace-with-a-generated-secret
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8100
COOKIE_SECURE=0
ALLOWED_USER_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8100/auth/callback

# Deprecated upgrade-only value for legacy_sha256_v1 matching/backfill.
ACCOUNT_HASH_SALT=replace-with-a-generated-secret
BACKUP_PASSPHRASE=replace-with-a-generated-secret
DOCUMENTS_DIR=/var/lib/oneledger/documents

# Official market-price source for mutual-fund NAV (Phase 1.6 Task 18); see .env.example.
OFFICIAL_NAV_URL=https://portal.amfiindia.com/spages/NAVAll.txt
OFFICIAL_NAV_CURRENCY=INR
