# .env.example — committed. Copy to .env (git-ignored) and fill in.
# Public — the browser needs to know where the API is.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service only. NEVER prefixed NEXT_PUBLIC_. Never committed.
#
# The database connection lives here as PARTS, not as a URL. A DSN in this file would hold a
# second copy of the password, and two copies of one value drift: set the password without
# updating the URL and the containers come up fine while every local `uv run` fails to
# authenticate, which reads as a broken service rather than a typo.
#   Host-side DSN, when a shell needs one:   DATABASE_URL="$(scripts/dsn.sh)"
POSTGRES_USER=oneledger
POSTGRES_PASSWORD=oneledger
POSTGRES_DB=oneledger
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

SESSION_SECRET=                 # openssl rand -hex 32 — signs the session cookie
COOKIE_SECURE=0                 # local HTTP = 0; set 1 behind HTTPS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Where the service sends the browser after sign-in. The web app, not the API.
WEB_ORIGIN=http://localhost:3000

# The single permitted Google account. Any other is rejected at the app layer.
ALLOWED_USER_EMAIL=you@example.com

# The household name, the owner's display name and tax residency, and the reporting pair are
# application data, not configuration: they are seeded neutral by the migrations and edited in
# Settings > Household. Choose the reporting pair there before the first import — both amounts
# are frozen per row, so changing the pair afterwards is a backfill (ADR-0002).

# Deprecated upgrade-only salt. Keep the existing value while legacy_sha256_v1 identifiers remain;
# it is used only for read-only matching and guarded statement backfill, never for new identities.
ACCOUNT_HASH_SALT=

# Encrypts database backups at rest (openssl rand -hex 32). Losing it makes every existing
# backup unrestorable; scripts/backup-db.sh refuses to write an unencrypted dump without it.
# The compose `backup` service reads it to take the daily dump. See security-and-privacy.html §9.
BACKUP_PASSPHRASE=

DOCUMENTS_DIR=/var/lib/oneledger/documents

# Official market-price source for mutual-fund NAV (Phase 1.6 Task 18). The capability key
# `official_nav_text_v1` selects the parser, never an institution or country name in code — see
# docs/superpowers/specs/2026-09-12-phase-1-6-investments.md "Prices and valuations".
OFFICIAL_NAV_URL=https://portal.amfiindia.com/spages/NAVAll.txt
OFFICIAL_NAV_CURRENCY=INR
